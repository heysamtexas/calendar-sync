# Calendar Sync Tool - Environment Configuration
# This is a comprehensive example of all available environment variables
# Copy this file to .env and update with your actual values

# =============================================================================
# DJANGO CORE SETTINGS
# =============================================================================

# Set to False in production
DEBUG=True

# Generate a secure secret key for production
# You can use: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here-change-this-in-production

# Comma-separated list of allowed hosts
# For production, include your domain: example.com,www.example.com
ALLOWED_HOSTS=localhost,127.0.0.1

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Database URL - supports SQLite, PostgreSQL, MySQL/MariaDB
# SQLite (default for development)
DATABASE_URL=sqlite:///db.sqlite3

# PostgreSQL (recommended for production)
# Requires psycopg2-binary (included in dependencies)
# DATABASE_URL=postgresql://username:password@localhost:5432/calendar_sync
# DATABASE_URL=postgresql://username:password@db.example.com:5432/calendar_sync
# With SSL: postgresql://username:password@db.example.com:5432/calendar_sync?sslmode=require

# MySQL/MariaDB
# DATABASE_URL=mysql://username:password@localhost:3306/calendar_sync

# =============================================================================
# GOOGLE OAUTH CONFIGURATION
# =============================================================================

# Get these credentials from Google Cloud Console:
# 1. Visit https://console.cloud.google.com/
# 2. Create a new project or select existing
# 3. Enable Google Calendar API
# 4. Create OAuth 2.0 credentials (Web application)
# 5. Set authorized redirect URI: http://localhost:8000/auth/callback/
# 6. For production, add your production domain redirect URI

GOOGLE_OAUTH_CLIENT_ID=your-google-client-id-from-cloud-console
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret-from-cloud-console

# =============================================================================
# WEBHOOK CONFIGURATION
# =============================================================================

# Base URL for webhook notifications (used by Google Calendar API)
# For development: http://localhost:8000
# For production: https://yourdomain.com
WEBHOOK_BASE_URL=http://localhost:8000

# CSRF trusted origins (comma-separated)
# Include all domains that will send POST requests to your app
CSRF_TRUSTED_ORIGINS=http://localhost:8000,https://localhost:8000

# =============================================================================
# SECURITY SETTINGS
# =============================================================================

# Force HTTPS in production (automatically enabled when DEBUG=False)
# Set to True to force HTTPS even with DEBUG=True
USE_TLS=False

# =============================================================================
# OPTIONAL SETTINGS
# =============================================================================

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Time zone (defaults to UTC)
# Examples: America/New_York, Europe/London, Asia/Tokyo
TIME_ZONE=UTC

# =============================================================================
# PRODUCTION DEPLOYMENT EXAMPLES
# =============================================================================

# Railway.app deployment example:
# DEBUG=False
# SECRET_KEY=your-production-secret-key
# DATABASE_URL=postgresql://postgres:password@roundhouse.proxy.rlwy.net:port/railway
# ALLOWED_HOSTS=yourdomain.railway.app
# WEBHOOK_BASE_URL=https://yourdomain.railway.app
# CSRF_TRUSTED_ORIGINS=https://yourdomain.railway.app

# Heroku deployment example:
# DEBUG=False
# SECRET_KEY=your-production-secret-key
# DATABASE_URL=postgres://... (automatically provided by Heroku Postgres)
# ALLOWED_HOSTS=yourapp.herokuapp.com
# WEBHOOK_BASE_URL=https://yourapp.herokuapp.com
# CSRF_TRUSTED_ORIGINS=https://yourapp.herokuapp.com

# DigitalOcean App Platform example:
# DEBUG=False
# SECRET_KEY=your-production-secret-key
# DATABASE_URL=postgresql://username:password@db-postgresql-nyc1-xxxxx-do-user-xxxxx-0.b.db.ondigitalocean.com:25060/defaultdb?sslmode=require
# ALLOWED_HOSTS=yourapp.ondigitalocean.app
# WEBHOOK_BASE_URL=https://yourapp.ondigitalocean.app
# CSRF_TRUSTED_ORIGINS=https://yourapp.ondigitalocean.app